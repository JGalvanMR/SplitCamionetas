<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#111827">
	<TextView
		android:textColor="@android:color/white"
		android:textSize="16sp"
		android:text="SPLIT:"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/splitcantidadcom"
		android:gravity="right"
		android:singleLine="true" />
	<TextView
		android:textColor="@android:color/white"
		android:textSize="16sp"
		android:text="PEDIDO:"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/pedidoencapturacom"
		android:gravity="right"
		android:singleLine="true" />
	<RadioGroup
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">
		<RadioButton
			android:textColor="@android:color/white"
			android:textSize="16sp"
			android:id="@+id/comradio_blanco"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:scaleX="0.9"
			android:scaleY="0.9"
			android:checked="true"
			android:text="CAJA X CAJA" />
		<RadioButton
			android:textColor="@android:color/white"
			android:textSize="16sp"
			android:id="@+id/comradio_verde"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:scaleX="0.9"
			android:scaleY="0.9"
			android:text="TARIMA COMPLETA" />
	</RadioGroup>
	<TextView
		android:textColor="@android:color/white"
		android:textSize="16sp"
		android:text="CODIGO:"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/textView12"
		android:singleLine="true" />
	<EditText
		android:inputType="text"
		android:singleLine="true"
		android:maxLines="1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/Foliocom"
		android:imeOptions="actionDone" />
	<Button
		android:textColor="@android:color/white"
		android:textSize="16sp"
		android:text="Grabar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/GuardarCapturadocom"
		android:layout_marginTop="0.0dp" />
	<TextView
		android:textColor="@android:color/white"
		android:textSize="16sp"
		android:text="000"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/totalcapturadocom" />
	<GridView
		android:minWidth="25px"
		android:minHeight="25px"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:numColumns="1"
		android:id="@+id/gvCtr2com"
		android:layout_weight="1"
		android:columnWidth="150dp" />
	<CheckBox
		android:textColor="@android:color/white"
		android:textSize="16sp"
		android:text="Eliminar Caja"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/Eliminar" />
</LinearLayout>