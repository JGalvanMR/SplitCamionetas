<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:padding="8dp">

	<!-- Opciones de Captura (RadioGroup responsivo) -->
	<RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
		<RadioButton
            android:id="@+id/radio_blanco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scaleX="0.9"
            android:scaleY="0.9"
            android:checked="true"
            android:text="CAJA X CAJA"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>
		<RadioButton
            android:id="@+id/radio_verde"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scaleX="0.9"
            android:scaleY="0.9"
            android:text="TARIMA COMPLETA"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>
	</RadioGroup>

	<!-- Campo de Código -->
	<TextView
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:text="CODIGO:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:id="@+id/textView12"
        android:singleLine="true" />

	<EditText
        android:inputType="text"
        android:singleLine="true"
        android:maxLines="1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="#1F2937"
        android:textColor="@android:color/white"
        android:textColorHint="#6B7280"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:id="@+id/Folio"
        android:imeOptions="actionDone" />

	<!-- Botón Grabar -->
	<Button
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Grabar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#2563EB"
        android:layout_marginBottom="12dp"
        android:id="@+id/GuardarCapturado" />

	<!-- Total capturado -->
	<TextView
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:id="@+id/totalcapturado" />

	<!-- Listado (GridView) -->
	<GridView
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="1"
        android:id="@+id/gvCtr2"
        android:columnWidth="150dp"
        android:layout_marginBottom="8dp" />

	<!-- CheckBox Eliminar Caja -->
	<CheckBox
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:text="Eliminar Caja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/Eliminar" />

</LinearLayout>