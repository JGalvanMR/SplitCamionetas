<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:padding="4dp">

	<TextView
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:text="Small Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:id="@+id/usuario" />

	<TextView
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:text="Pedido:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:id="@+id/textView2"
        android:singleLine="true"
        android:imeOptions="actionDone" />

	<EditText
        android:textColor="@android:color/white"
        android:textColorHint="#6B7280"
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:background="#1F2937"
        android:padding="6dp"
        android:id="@+id/agregarpedido" />

	<TextView
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:text="Listado de Pedidos Agregados:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:id="@+id/textView3" />

	<Spinner
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:id="@+id/pedidos"
        android:background="#1F2937"
        android:popupBackground="#1F2937"
        android:spinnerMode="dropdown" />

	<Button
        android:minHeight="0dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="Capturar"
        android:layout_width="match_parent"
		android:layout_height="40dp"
        android:backgroundTint="#2563EB"
        android:layout_marginBottom="8dp"
        android:id="@+id/button1" />

	<TextView
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:text="DETALLE DE PRODUCTO:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:id="@+id/textView4" />

	<GridView
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:numColumns="1"
        android:id="@+id/gvCtrl"
        android:layout_weight="1"
        android:columnWidth="150dp" />

</LinearLayout>