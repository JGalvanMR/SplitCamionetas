<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:padding="8dp">

	<!-- Usuario o Info secundaria -->
	<TextView
        android:textColor="#9CA3AF"
        android:textSize="14sp"
        android:text="Small Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:id="@+id/usercancel" />

	<!-- Etiqueta del Pedido a Cancelar -->
	<TextView
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:text="Pedido A Cancelar:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:singleLine="true"
        android:imeOptions="actionDone" />

	<!-- Campo de Entrada del Pedido -->
	<EditText
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="#1F2937"
        android:textColor="@android:color/white"
        android:textColorHint="#6B7280"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:id="@+id/pedidocancelar" />

	<!-- Título de la Lista -->
	<TextView
        android:textColor="#9CA3AF"
        android:textSize="14sp"
        android:text="Split Capturados:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

	<!-- Listado (GridView) -->
	<GridView
        android:minWidth="25px"
        android:minHeight="25px"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="1"
        android:id="@+id/gvCtrCancel"
        android:columnWidth="150dp"
        android:layout_marginBottom="12dp" />

	<!-- Totales / Resumen -->
	<TextView
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Total de Splits: 000:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/SplitCargados" />

</LinearLayout>